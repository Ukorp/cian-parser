# Telegram bot token — create a bot via @BotFather on Telegram, send /newbot, follow prompts.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram chat id to receive notifications — for a personal chat, message @userinfobot
# (or @RawDataBot) and it will reply with your numeric chat id. For a group chat, add the
# bot to the group and use the group's (negative) chat id instead.
CHAT_ID=123456789

# One or more Cian.ru search URLs to poll, comma-separated (no spaces around commas).
# Build a URL by setting your filters at https://www.cian.ru and copying the resulting
# search page URL. If unset, a default example search is used.
# SEARCH_URLS=https://www.cian.ru/cat.php?...,https://www.cian.ru/cat.php?...
